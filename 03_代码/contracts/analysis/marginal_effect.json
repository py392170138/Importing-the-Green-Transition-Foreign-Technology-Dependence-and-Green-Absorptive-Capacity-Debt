  "period": null,
  "zero_semantics": {
    "estimate": "valid_exact_zero_marginal_effect",
    "p_value": "valid_numerical_underflow_to_zero",
    "wild_p_value": "valid_bootstrap_probability_zero_when_bootstrap_is_required"
  },
  "null_semantics": {
    "wild_conf_low": "nonnull_when_inference_status=wild_bootstrap_required; null_when_wild_bootstrap_unbounded_or_not_required",
    "wild_conf_high": "nonnull_when_inference_status=wild_bootstrap_required; null_when_wild_bootstrap_unbounded_or_not_required",
    "wild_p_value": "nonnull_when_inference_status_is_wild_bootstrap_required_or_wild_bootstrap_unbounded; otherwise_null",
    "wild_draws": "nonnull_when_inference_status_is_wild_bootstrap_required_or_wild_bootstrap_unbounded; otherwise_null",
    "wild_seed": "nonnull_when_inference_status_is_wild_bootstrap_required_or_wild_bootstrap_unbounded; otherwise_null"
  },
  "transformations": [
    "evaluate_beta_gimc_plus_gad_value_times_beta_interaction_at_frozen_marginal_quantiles",
    "include_the_model_covariance_term_in_every_standard_error",
    "wild_bootstrap_reparameterizes_the_same_model_at_each_gad_value",
    "encode_a_two_sided_unbounded_wild_interval_as_null_bounds_with_inference_status_wild_bootstrap_unbounded"
  ]
