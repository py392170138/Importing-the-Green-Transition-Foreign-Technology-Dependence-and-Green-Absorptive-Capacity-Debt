{
  "table_id": "baci_green_bilateral",
  "schema_version": "1.0.0",
  "primary_key": [
    "taxonomy_version",
    "year",
    "exporter_id",
    "importer_id",
    "hs6"
  ],
  "columns": {
    "taxonomy_version": "String",
    "year": "Int16",
    "exporter_id": "String",
    "importer_id": "String",
    "hs6": "String",
    "trade_value_usd": "Float64",
    "quantity_tonnes": "Float64",
    "quantity_observation_count": "UInt64",
    "green_weight": "Float64",
    "weighted_green_trade_usd": "Float64",
    "source_row_count": "UInt64"
  },
  "units": {
    "trade_value_usd": "current_USD",
    "quantity_tonnes": "metric_tonnes",
    "quantity_observation_count": "source_rows_with_reported_quantity",
    "green_weight": "fraction",
    "weighted_green_trade_usd": "current_USD",
    "source_row_count": "source_rows"
  },
  "period": [1996, 2024],
  "zero_semantics": {
