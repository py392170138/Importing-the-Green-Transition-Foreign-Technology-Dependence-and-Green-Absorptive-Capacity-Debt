{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base_table_contract.schema.json",
  "title": "Authoritative Parquet table contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_id",
    "schema_version",
    "primary_key",
    "columns",
    "units"
  ],
  "properties": {
    "table_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "primary_key": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "units": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "period": {
      "type": ["array", "null"],
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "zero_semantics": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "null_semantics": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "transformations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
