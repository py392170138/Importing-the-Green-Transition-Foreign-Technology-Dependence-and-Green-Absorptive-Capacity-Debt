{
  "table_id": "wdi_country_year",
  "schema_version": "1.0.0",
  "primary_key": [
    "economy_id",
    "year",
    "indicator_id"
  ],
  "columns": {
    "economy_id": "String",
    "year": "Int16",
    "indicator_id": "String",
    "value": "Float64",
    "unit": "String",
    "source_update": "String",
    "source_status": "String"
  },
  "units": {
    "value": "indicator_specific_frozen_unit"
  },
  "period": [1996, 2024],
  "zero_semantics": {
    "value": "reported_numeric_zero_is_retained_and_API_null_remains_null"
  },
  "transformations": [
    "validate_single_page_WDI_envelope",
    "require_exact_indicator_and_metadata_identity",
    "map_country_only_after_recording_raw_coverage",
    "exclude_WDI_aggregates_through_frozen_crosswalk",
    "never_load_rejected_EN_ATM_CO2E_KT_response"
  ]
}
